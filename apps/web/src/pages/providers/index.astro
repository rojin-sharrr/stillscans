---
import { providers } from "@stillscans/providers";
import { Checker } from "../../components/Checker";
import { ProviderDirectory } from "../../components/ProviderDirectory";
import { SiteHeader } from "../../components/SiteHeader";
import SiteFooter from "../../components/SiteFooter.astro";
import Base from "../../layouts/Base.astro";
---

<Base
  title="QR code providers: what happens when you stop paying? · StillScans"
  description="A neutral directory of QR code providers: free options, redirect domains, and what each company's own pages say happens to your codes when you stop paying."
>
  <SiteHeader client:load onDirectory />
  <main class="wrap directory">
    <h1 class="h1">QR code providers: what happens when you stop paying?</h1>
    <p class="lead">Static codes hold your link directly and aren't affected. Dynamic codes send every scan through the provider's redirect domain, like <span class="mono" style="font-size:15px;color:var(--ink)">qrco.de</span>, so the code only works while that provider keeps forwarding. Each entry links to the provider's own pages.</p>

    <ProviderDirectory client:load providers={providers} />

    <p class="small muted" style="margin-top:16px">Is something out of date? <a href="/report" style="font-weight:600;text-underline-offset:3px">Report an update</a>. Providers can reply too.</p>

    <section aria-labelledby="dir-check" class="card check-band">
      <div class="check-band__copy">
        <h2 id="dir-check">Have a code from one of these? Check it.</h2>
        <p>We'll match its redirect domain to the provider and show what their policy says.</p>
      </div>
      <div class="check-band__widget">
        <Checker client:visible compact idPrefix="dir" />
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
