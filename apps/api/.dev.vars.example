# Copy to .dev.vars for local development. .dev.vars is git-ignored.
ENVIRONMENT=development
WEB_ORIGIN=http://localhost:4321
API_ORIGIN=http://localhost:8788
# Empty on purpose: overrides the production cookie domain in wrangler.toml.
COOKIE_DOMAIN=
# Optional: without a key, destinations are not checked against threat lists.
# WEB_RISK_API_KEY=
# Required for sign-in. The redirect URI is
# http://localhost:8788/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
